# Sao chép file này thành .env.local tại thư mục gốc dự án.
# Thay các giá trị mẫu bằng thông tin từ Connect trong Supabase Dashboard.
# Hướng dẫn: https://supabase.com/docs/guides/getting-started/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Chỉ dùng publishable key cho biến NEXT_PUBLIC_.
# Không đặt secret key hoặc service_role key vào biến công khai.
# Frontend hiện dùng dữ liệu mẫu; các biến này chuẩn bị cho bước kết nối Supabase.
